            ),

        verticalAlignment = Alignment.CenterVertically
    ) {

        SettingsIcon(
            icon = icon
        )

        Spacer(
            modifier = Modifier.size(12.dp)
        )

        Column(
            modifier = Modifier.weight(1f)
        ) {

            Text(
                text = title,
                color = FinzoWhite,
                fontSize = 14.sp,
                fontWeight = FontWeight.SemiBold
            )

            Spacer(
                modifier = Modifier.height(2.dp)
            )

            Text(
                text = subtitle,
                color = FinzoGray,
                fontSize = 11.sp
            )
        }

        Icon(
            imageVector = Icons.Default.ArrowForwardIos,
            contentDescription = null,
            tint = FinzoGray,
            modifier = Modifier.size(14.dp)
        )
    }
}

@Composable
private fun ChangePasswordDialog(
    securityManager: SecurityManager,
    onDismiss: () -> Unit
) {

    val context = LocalContext.current

    var username by remember {
        mutableStateOf("")
    }

    var oldPassword by remember {
        mutableStateOf("")
    }

    var newPassword by remember {
        mutableStateOf("")
    }

    var confirmPassword by remember {
        mutableStateOf("")
    }

    var error by remember {
        mutableStateOf("")
    }

    AlertDialog(

        onDismissRequest = onDismiss,

        title = {

            Text(
                stringResource(
                    R.string.change_password
                )
            )
        },

        text = {

            Column(
                verticalArrangement =
                    Arrangement.spacedBy(10.dp)
            ) {

                OutlinedTextField(
                    value = username,
                    onValueChange = {
                        username = it
                        error = ""
                    },
                    label = {
                        Text(
                            stringResource(
                                R.string.username
                            )
                        )
                    },
                    singleLine = true
                )

                OutlinedTextField(
                    value = oldPassword,
                    onValueChange = {
                        oldPassword = it
                        error = ""
                    },
                    label = {
                        Text(
                            stringResource(
                                R.string.current_password
                            )
                        )
                    },
                    singleLine = true,
                    visualTransformation =
                        PasswordVisualTransformation()
                )

                OutlinedTextField(
                    value = newPassword,
                    onValueChange = {
                        newPassword = it
                        error = ""
                    },
                    label = {
                        Text(
                            stringResource(
                                R.string.new_password
                            )
                        )
                    },
                    singleLine = true,
                    visualTransformation =
                        PasswordVisualTransformation()
                )

                OutlinedTextField(
                    value = confirmPassword,
                    onValueChange = {
                        confirmPassword = it
                        error = ""
                    },
                    label = {
                        Text(
                            stringResource(
                                R.string.confirm_new_password
                            )
                        )
                    },
                    singleLine = true,
                    visualTransformation =
                        PasswordVisualTransformation()
                )

                if (error.isNotEmpty()) {

                    Text(
                        text = error,
                        color = FinzoRed,
                        fontSize = 12.sp
                    )
                }
            }
        },

        confirmButton = {

            Button(

                onClick = {

                    when {

                        !securityManager.verifyAccount(
                            username.trim(),
                            oldPassword
                        ) -> {

                            error =
                                context.getString(
                                    R.string.username_current_password_incorrect
                                )
                        }

                        newPassword.length < 6 -> {

                            error =
                                context.getString(
                                    R.string.password_minimum_length
                                )
                        }

                        newPassword != confirmPassword -> {

                            error =
                                context.getString(
                                    R.string.passwords_do_not_match
                                )
                        }

                        else -> {

                            securityManager.setAccount(
                                username.trim(),
                                newPassword
                            )

                            onDismiss()
                        }
                    }
                },

                colors = ButtonDefaults.buttonColors(
                    containerColor = FinzoOrange,
                    contentColor = Color.Black
                )
            ) {

                Text(
                    text = stringResource(
                        R.string.save
                    ).uppercase(),

                    fontWeight = FontWeight.Bold
                )
            }
        },

        dismissButton = {

            TextButton(
                onClick = onDismiss
            ) {

                Text(
                    text = stringResource(
                        R.string.cancel
                    ).uppercase(),

                    color = FinzoOrange
                )
            }
        }
    )
}

@Composable
private fun ChangeUsernameDialog(
    securityManager: SecurityManager,
    onDismiss: () -> Unit
) {

    val context = LocalContext.current

    var oldUsername by remember {
        mutableStateOf("")
    }

    var password by remember {
        mutableStateOf("")
    }

    var newUsername by remember {
        mutableStateOf("")
    }

    var error by remember {
        mutableStateOf("")
    }

    AlertDialog(

        onDismissRequest = onDismiss,

        title = {

            Text(
                stringResource(
                    R.string.change_username
                )
            )
        },

        text = {

            Column(
                verticalArrangement =
                    Arrangement.spacedBy(10.dp)
            ) {

                OutlinedTextField(
                    value = oldUsername,
                    onValueChange = {
                        oldUsername = it
                        error = ""
                    },
                    label = {
                        Text(
                            stringResource(
                                R.string.current_username
                            )
                        )
                    },
                    singleLine = true
                )

                OutlinedTextField(
                    value = password,
                    onValueChange = {
                        password = it
                        error = ""
                    },
                    label = {
                        Text(
                            stringResource(
                                R.string.password
                            )
                        )
                    },
                    singleLine = true,
                    visualTransformation =
                        PasswordVisualTransformation()
                )

                OutlinedTextField(
                    value = newUsername,
                    onValueChange = {
                        newUsername = it
                        error = ""
                    },
                    label = {
                        Text(
                            stringResource(
                                R.string.new_username
                            )
                        )
                    },
                    singleLine = true
                )

                if (error.isNotEmpty()) {

                    Text(
                        text = error,
                        color = FinzoRed,
                        fontSize = 12.sp
                    )
                }
            }
        },

        confirmButton = {

            Button(

                onClick = {

                    when {

                        !securityManager.verifyAccount(
                            oldUsername.trim(),
                            password
                        ) -> {

                            error =
                                context.getString(
                                    R.string.username_password_incorrect
                                )
                        }

                        newUsername.trim().isEmpty() -> {

                            error =
                                context.getString(
                                    R.string.enter_new_username
                                )
                        }

                        else -> {

                            securityManager.setAccount(
                                newUsername.trim(),
                                password
                            )

                            onDismiss()
                        }
                    }
                },

                colors = ButtonDefaults.buttonColors(
                    containerColor = FinzoOrange,
                    contentColor = Color.Black
                )
            ) {

                Text(
                    text = stringResource(
                        R.string.save
                    ).uppercase(),

                    fontWeight = FontWeight.Bold
                )
            }
        },

        dismissButton = {

            TextButton(
                onClick = onDismiss
            ) {

                Text(
                    text = stringResource(
                        R.string.cancel
                    ).uppercase(),

                    color = FinzoOrange
                )
            }
        }
    )
}

